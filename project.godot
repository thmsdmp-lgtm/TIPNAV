; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TIPNAV"
run/main_scene="uid://cfkb8y1mpcos2"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

Accelerometer="*uid://dh7fvwc6yqvyf"
PlaceManager="*uid://c12vdu55wowkx"
Gyroscope="*uid://crhhwj7pjikej"
PedestrianDeadReckoning="*uid://b6ei5ykp1sslx"
StepDetection="*uid://djbcp8k6uvp83"
StepLength="*uid://c5i5ycj18nq6x"
AdaptiveDetectionParameters="*uid://df4dd3r7gpe2j"
Magnetometer="*uid://c5p3x7u7ycv1m"
StepHeading="*uid://u2apqf5847f1"
PathManager="*uid://b2yphovic8qex"
SceneLabels="*uid://c21ena0y85oxm"

[display]

window/size/viewport_width=720
window/size/viewport_height=1600
window/size/window_width_override=300
window/size/window_height_override=650
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/max_fps=0

[editor_plugins]

enabled=PackedStringArray("res://addons/minimize_html_build/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

"Place Cards"=""

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=true
pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
scaling_3d/scale=0.7999999999999999
scaling_3d/fsr_sharpness=0.4
